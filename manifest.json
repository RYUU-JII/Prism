{
  "manifest_version": 3,
  "name": "Prism",
  "description": "Copy. Prism. Render. Instant HTML code previews in your side panel.",
  "version": "0.1.4",
  "permissions": ["sidePanel", "storage", "activeTab", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridges/clipboard-bridge.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/extractor/intelligent-extractor.js",
        "content/orb/patch-utils.js",
        "content/orb/chat-injector.js",
        "content/orb/orb-ui.js",
        "content/orb/orb-controller.js"
      ],
      "css": ["content/orb/orb.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/bridges/network-probe-main.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": { "default_path": "sidepanel/dist/index.html" },
  "sandbox": {
    "pages": ["sidepanel/sandbox.html"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
